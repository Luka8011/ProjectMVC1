{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING"
  },
  "JwtSettings": {
    "Secret": "YOUR_JWT_SECRET",
    "Issuer": "HospitalApp",
    "Audience": "HospitalAppUsers",
    "ExpiryInMinutes": 60
  }
}