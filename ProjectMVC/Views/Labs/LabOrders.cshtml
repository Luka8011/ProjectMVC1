@model IEnumerable<ClassLibrary1.Data.Models.LabOrder>

@{
    ViewData["Title"] = "Lab Orders";
    var userRole = Context.Session.GetString("UserRole");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Laboratory Orders</h2>
        @if (userRole == "Doctor")
        {
            <a asp-action="Create" class="btn btn-primary">+ Create New Order</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            No lab orders found.
        </div>
    }
    else
    {
        <div class="card shadow-sm p-3">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Order ID</th>
                            <th>Order Date</th>
                            <th>Doctor</th>
                            <th>Patient</th>
                            <th>Status</th>
                            <th>Associated Tests</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>#@order.LabOrderId</strong></td>
                                <td>@(order.OrderDate?.ToString("MMM dd, yyyy hh:mm tt") ?? "N/A")</td>
                                <td>
                                    @if (order.FkDoctor != null)
                                    {
                                        <span>Dr. @order.FkDoctor.DoctorFirstName @order.FkDoctor.DoctorLastName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (order.FkPatient != null)
                                    {
                                        <span>@order.FkPatient.PatientFirstName @order.FkPatient.PatientLastName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (order.OrderStatus == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (order.OrderStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@(order.OrderStatus ?? "Unknown")</span>
                                    }
                                </td>
                                <td>
                                    @if (order.LabResults != null && order.LabResults.Any())
                                    {
                                        var testNames = order.LabResults
                                            .Where(r => r.FkLabTest != null)
                                            .Select(r => r.FkLabTest.TestName);

                                        <span>@string.Join(", ", testNames)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No tests assigned</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>