@model IEnumerable<ClassLibrary1.Data.Models.Invoice>

@{
    ViewData["Title"] = "Invoices";
    string currentFilter = ViewData["CurrentFilter"]?.ToString() ?? "";
    string status = ViewData["Status"]?.ToString() ?? "All";
    int currentPage = ViewData["CurrentPage"] as int? ?? 1;
    int totalPages = ViewData["TotalPages"] as int? ?? 1;
    int totalCount = ViewData["TotalCount"] as int? ?? 0;
    int pageSize = ViewData["PageSize"] as int? ?? 10;
    decimal pendingTotal = ViewData["PendingTotal"] as decimal? ?? 0m;
    decimal paidTotal = ViewData["PaidTotal"] as decimal? ?? 0m;
    int overdueCount = ViewData["OverdueCount"] as int? ?? 0;
    var today = DateTime.Today;

    int firstShown = totalCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    int lastShown = Math.Min(currentPage * pageSize, totalCount);
    int windowStart = Math.Max(1, currentPage - 2);
    int windowEnd = Math.Min(totalPages, currentPage + 2);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Invoices &amp; Charges</h2>
        <a asp-action="CreateInvoice" class="btn btn-primary">+ Create Invoice</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center">
                <small class="text-muted">Outstanding</small>
                <h3 class="text-danger mb-0">$@pendingTotal.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center">
                <small class="text-muted">Collected</small>
                <h3 class="text-success mb-0">$@paidTotal.ToString("N2")</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 text-center">
                <small class="text-muted">Overdue invoices</small>
                <h3 class="@(overdueCount > 0 ? "text-danger" : "text-muted") mb-0">@overdueCount</h3>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Invoices" method="get" class="row g-2">
                <div class="col-md-6">
                    <input type="text" name="searchString" value="@currentFilter" class="form-control"
                           placeholder="Search by patient name..." />
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        @foreach (var s in new[] { "All", "Pending", "Paid", "Cancelled" })
                        {
                            <option value="@s" selected="@(s == status)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">No invoices found.</div>
    }
    else
    {
        <p class="text-muted small mb-2">Showing @firstShown–@lastShown of @totalCount invoices</p>

        <div class="card shadow-sm p-3">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Invoice</th>
                            <th>Created</th>
                            <th>Patient</th>
                            <th>For</th>
                            <th>Amount</th>
                            <th>Due</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model)
                        {
                            bool overdue = inv.InvoiceStatus == "Pending" && inv.DueDate.HasValue && inv.DueDate.Value.Date < today;
                            <tr>
                                <td><strong>#INV-@inv.InvoiceId</strong></td>
                                <td>@(inv.InvoiceCreationDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                <td>
                                    @if (inv.FkPatient != null)
                                    {
                                        <span>@inv.FkPatient.PatientFirstName @inv.FkPatient.PatientLastName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (inv.FkPrescription != null)
                                    {
                                        <span>@(inv.FkPrescription.FkMedication?.MedicationName ?? "Prescription") <small class="text-muted">(Rx #@inv.FkPrescription.PrescriptionId)</small></span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">General charge</span>
                                    }
                                </td>
                                <td class="fw-bold">$@((inv.AmountToPay ?? 0m).ToString("N2"))</td>
                                <td class="@(overdue ? "text-danger fw-bold" : "")">@(inv.DueDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                <td>
                                    @if (inv.InvoiceStatus == "Paid")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (inv.InvoiceStatus == "Pending")
                                    {
                                        <span class="badge @(overdue ? "bg-danger" : "bg-warning text-dark")">@(overdue ? "Overdue" : "Pending")</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@(inv.InvoiceStatus ?? "Unknown")</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="EditInvoice" asp-route-id="@inv.InvoiceId" class="btn btn-sm btn-outline-primary">
                                        @(inv.InvoiceStatus == "Paid" ? "View" : "Manage")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Invoice pages" class="mt-4">
                <ul class="pagination justify-content-center flex-wrap">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Invoices" asp-route-page="@(currentPage - 1)"
                           asp-route-searchString="@currentFilter" asp-route-status="@status">&laquo; Previous</a>
                    </li>
                    @if (windowStart > 1)
                    {
                        <li class="page-item"><a class="page-link" asp-action="Invoices" asp-route-page="1"
                                                 asp-route-searchString="@currentFilter" asp-route-status="@status">1</a></li>
                        @if (windowStart > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }
                    @for (int i = windowStart; i <= windowEnd; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Invoices" asp-route-page="@i"
                               asp-route-searchString="@currentFilter" asp-route-status="@status">@i</a>
                        </li>
                    }
                    @if (windowEnd < totalPages)
                    {
                        @if (windowEnd < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        <li class="page-item"><a class="page-link" asp-action="Invoices" asp-route-page="@totalPages"
                                                 asp-route-searchString="@currentFilter" asp-route-status="@status">@totalPages</a></li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Invoices" asp-route-page="@(currentPage + 1)"
                           asp-route-searchString="@currentFilter" asp-route-status="@status">Next &raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
