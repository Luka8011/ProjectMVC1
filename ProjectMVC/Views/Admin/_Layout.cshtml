<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjectMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ProjectMVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (@Context.Session.GetString("UserRole") == "Doctor")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Doctors" asp-action="Appointments">Appointments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="LabResults" asp-action="Index">Lab Results</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="LabOrders" asp-action="Index">Lab Orders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="MedicalRecords" asp-action="Index">Medical Records</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Medication" asp-action="Index">Medications</a>
                            </li>
                        }
                        else if (@Context.Session.GetString("UserRole") == "User")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Payment" asp-action="Payments">Payments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Doctors" asp-action="DoctorsView">Doctors</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Doctors" asp-action="Appointments">Appointments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Medication" asp-action="MyPrescriptions">My Prescriptions</a>
                            </li>
                        }
                        else if (@Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Invoices">Invoices</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="CreateInvoice">Create Invoice</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Medication" asp-action="Index">Medications</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            @using Microsoft.AspNetCore.Http

            @if (Context.Session.GetInt32("UserId") != null)
            {
                <span class="navbar-text">
                    Welcome, @Context.Session.GetString("UserName") (@Context.Session.GetString("UserRole"))
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                </form>
            }
            else
            {
                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
            }
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ProjectMVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
