@{
    ViewData["Title"] = "Create Invoice";
    var patients = ViewBag.Patients as IEnumerable<ClassLibrary1.Data.Models.Patient>
                   ?? Enumerable.Empty<ClassLibrary1.Data.Models.Patient>();
    var prescriptions = ViewBag.Prescriptions as IEnumerable<ClassLibrary1.Data.Models.Prescription>
                        ?? Enumerable.Empty<ClassLibrary1.Data.Models.Prescription>();
    var rxData = prescriptions.Select(p => new
    {
        id = p.PrescriptionId,
        patientId = p.FkPatientId,
        label = $"Rx #{p.PrescriptionId} — {p.FkMedication?.MedicationName} ({p.PrescriptionDate:MMM dd, yyyy})",
        price = p.FkMedication?.UnitPrice
    });
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create Invoice</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="Admin" asp-action="CreateInvoice" method="post">

                        <div class="mb-3">
                            <label for="patientId" class="form-label fw-bold">Patient</label>
                            <select id="patientId" name="patientId" class="form-select" required>
                                <option value="">-- Choose a Patient --</option>
                                @foreach (var p in patients)
                                {
                                    <option value="@p.PatientId">@p.PatientFirstName @p.PatientLastName@(p.PatientDob.HasValue ? $" — DOB {p.PatientDob:yyyy-MM-dd}" : "")</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="prescriptionId" class="form-label fw-bold">Prescription <span class="text-muted fw-normal">(optional)</span></label>
                            <select id="prescriptionId" name="prescriptionId" class="form-select" disabled>
                                <option value="">General charge (no prescription)</option>
                            </select>
                            <div class="form-text">Only prescriptions that haven't been invoiced yet are listed.</div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label for="amount" class="form-label fw-bold">Amount ($)</label>
                                <input type="number" id="amount" name="amount" class="form-control"
                                       min="0.01" max="1000000" step="0.01" required />
                            </div>
                            <div class="col-md-6">
                                <label for="dueDate" class="form-label fw-bold">Due date</label>
                                <input type="date" id="dueDate" name="dueDate" class="form-control"
                                       value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Invoices" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Create Invoice</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const prescriptions = @Html.Raw(Json.Serialize(rxData));
        const patientSel = document.getElementById('patientId');
        const rxSel = document.getElementById('prescriptionId');
        const amount = document.getElementById('amount');
        let amountTouched = false;
        amount.addEventListener('input', () => amountTouched = true);

        patientSel.addEventListener('change', () => {
            const pid = Number(patientSel.value);
            rxSel.innerHTML = '<option value="">General charge (no prescription)</option>';
            prescriptions.filter(p => p.patientId === pid).forEach(p => {
                const o = document.createElement('option');
                o.value = p.id; o.textContent = p.label;
                rxSel.appendChild(o);
            });
            rxSel.disabled = !pid;
        });

        rxSel.addEventListener('change', () => {
            const rx = prescriptions.find(p => String(p.id) === rxSel.value);
            if (rx && rx.price != null && (!amountTouched || !amount.value)) {
                amount.value = Number(rx.price).toFixed(2);
                amountTouched = false;
            }
        });
    </script>
}
