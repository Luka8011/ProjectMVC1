@model ProjectMVC.Models.PaymentModel

@{
    ViewData["Title"] = "My Charges & Payments";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <h2>Billing & Charges</h2>
            <p class="text-muted mb-0">View outstanding medical balances and payment records for @Model.UserName.</p>
        </div>
        <div class="col-md-4">
            <div class="card bg-light border-0 shadow-sm p-3 text-center">
                <span class="text-secondary fw-bold">Total Outstanding</span>
                <h1 class="text-danger my-1">$@Model.TotalPendingBalance.ToString("N2")</h1>
                <small class="text-muted">@Model.PendingInvoices.Count pending invoice(s)</small>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Pending Invoices</h5>
            <span class="badge bg-dark">Action Required</span>
        </div>
        <div class="card-body p-0">
            @if (Model.PendingInvoices.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Invoice #</th>
                                <th>Description</th>
                                <th>Due Date</th>
                                <th>Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PendingInvoices)
                            {
                                <tr>
                                    <td><strong>#INV-@item.InvoiceId</strong></td>
                                    <td>
                                        <div>@item.Description</div>
                                        <small class="text-muted">Patient: @item.PatientName</small>
                                    </td>
                                    <td class="text-danger">@(item.DueDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                    <td class="fw-bold text-danger">$@item.AmountToPay.ToString("F2")</td>
                                    <td>
                                        <form asp-controller="Payment" asp-action="PayInvoice" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="invoiceId" value="@item.InvoiceId" />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                Pay Now
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-success">
                    <strong>No pending charges found!</strong>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Payment History</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.PaidInvoices.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Invoice #</th>
                                <th>Paid On</th>
                                <th>Description</th>
                                <th>Amount Paid</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PaidInvoices)
                            {
                                <tr>
                                    <td>#INV-@item.InvoiceId</td>
                                    <td>@(item.InvoicePaymentDate?.ToString("MMM dd, yyyy - hh:mm tt") ?? "N/A")</td>
                                    <td>
                                        <div>@item.Description</div>
                                        <small class="text-muted">Patient: @item.PatientName</small>
                                    </td>
                                    <td>$@item.AmountToPay.ToString("F2")</td>
                                    <td>
                                        <span class="badge bg-success">Paid</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    No completed payments on record.
                </div>
            }
        </div>
    </div>
</div>