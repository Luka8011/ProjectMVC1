@model ProjectMVC.Models.LoginModel

<div>
    <h2>Register</h2>
    <form asp-controller="Account" asp-action="Register" method="post">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label for="UserName" class="form-label">User Name</label>
            <input type="text" id="UserName" name="UserName" class="form-control" placeholder="Enter Name" required />
        </div>

        <div class="mb-3">
            <label for="UserEmail" class="form-label">Email Address</label>
            <input type="email" id="UserEmail" name="UserEmail" class="form-control" placeholder="Enter Email" required />
        </div>

        <div class="mb-3">
            <label for="UserPassword" class="form-label">Password</label>
            <input type="password" id="UserPassword" name="UserPassword" class="form-control" placeholder="Enter Password" required />
        </div>

        <button type="submit" class="btn btn-primary">Register</button>
    </form>
</div>