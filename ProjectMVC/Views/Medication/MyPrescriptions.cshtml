@model IEnumerable<ClassLibrary1.Data.Models.Prescription>

@{
    ViewData["Title"] = "My Prescriptions";
    var today = DateTime.Today;
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold">My Prescriptions</h2>
        <p class="text-muted mb-0">Medications your doctors have prescribed to you.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            You don't have any prescriptions yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm p-3">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Medication</th>
                            <th>Dosage</th>
                            <th>Frequency</th>
                            <th>Duration</th>
                            <th>Doctor</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rx in Model)
                        {
                            var endDate = rx.PrescriptionDate?.Date.AddDays(rx.DurationDays ?? 0);
                            bool active = endDate.HasValue && endDate.Value >= today;

                            <tr>
                                <td>@(rx.PrescriptionDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                <td>
                                    <strong>@(rx.FkMedication?.MedicationName ?? "Unknown medication")</strong>
                                    @if (!string.IsNullOrWhiteSpace(rx.FkMedication?.MedicationDescription))
                                    {
                                        <br /><small class="text-muted">@rx.FkMedication.MedicationDescription</small>
                                    }
                                </td>
                                <td>@(rx.Dosage ?? "—")</td>
                                <td>@(rx.Frequency ?? "—")</td>
                                <td>
                                    @if (rx.DurationDays.HasValue)
                                    {
                                        <span>@rx.DurationDays day@(rx.DurationDays == 1 ? "" : "s")</span>
                                        @if (endDate.HasValue)
                                        {
                                            <br /><small class="text-muted">until @endDate.Value.ToString("MMM dd, yyyy")</small>
                                        }
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>
                                    @if (rx.FkDoctor != null)
                                    {
                                        <span>Dr. @rx.FkDoctor.DoctorFirstName @rx.FkDoctor.DoctorLastName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (active)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
