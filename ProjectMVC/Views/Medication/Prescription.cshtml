@model ClassLibrary1.Data.Models.Medication

@{
    ViewData["Title"] = "Prescribe Medication";
    var patients = ViewBag.Patients as IEnumerable<ClassLibrary1.Data.Models.Patient>
                   ?? Enumerable.Empty<ClassLibrary1.Data.Models.Patient>();
    bool outOfStock = (Model.StockQuantity ?? 0) <= 0;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Prescribe Medication</h4>
                </div>
                <div class="card-body">

                    <!-- Selected medication summary -->
                    <div class="d-flex align-items-center border rounded p-3 bg-light mb-4">
                        <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/default-medicine.png" : Model.ImagePath)"
                             alt="@Model.MedicationName"
                             style="height:72px; width:72px; object-fit:contain;"
                             class="me-3"
                             onerror="this.src='/images/default-medicine.png'" />
                        <div class="flex-grow-1">
                            <h5 class="fw-bold mb-1">@Model.MedicationName</h5>
                            <p class="text-muted small mb-0">
                                @(string.IsNullOrWhiteSpace(Model.MedicationDescription)
                                    ? "No description available."
                                    : Model.MedicationDescription)
                            </p>
                        </div>
                        <div class="text-end ms-3">
                            @if (outOfStock)
                            {
                                <span class="badge bg-danger">Out of stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@Model.StockQuantity in stock</span>
                            }
                        </div>
                    </div>

                    @if (outOfStock)
                    {
                        <div class="alert alert-warning">
                            This medication is currently out of stock. You can still issue the prescription.
                        </div>
                    }

                    <form asp-controller="Medication" asp-action="Prescribe" method="post">
                        <input type="hidden" name="medicationId" value="@Model.MedicationId" />

                        <!-- Select patient -->
                        <div class="mb-3">
                            <label for="patientId" class="form-label fw-bold">Select Patient</label>
                            <select id="patientId" name="patientId" class="form-select form-select-lg" required>
                                <option value="">-- Choose a Patient --</option>
                                @foreach (var p in patients)
                                {
                                    <option value="@p.PatientId">
                                        @p.PatientFirstName @p.PatientLastName@(p.PatientDob.HasValue ? $" — DOB {p.PatientDob:yyyy-MM-dd}" : "")
                                    </option>
                                }
                            </select>
                            @if (!patients.Any())
                            {
                                <div class="form-text text-danger">No patients found.</div>
                            }
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label for="dosage" class="form-label fw-bold">Dosage</label>
                                <input type="text" id="dosage" name="dosage" class="form-control"
                                       placeholder="e.g. 500 mg" maxlength="100" required />
                            </div>
                            <div class="col-md-5">
                                <label for="frequency" class="form-label fw-bold">Frequency</label>
                                <input type="text" id="frequency" name="frequency" class="form-control"
                                       list="frequencyOptions" placeholder="e.g. Twice daily" maxlength="100" required />
                                <datalist id="frequencyOptions">
                                    <option value="Once daily"></option>
                                    <option value="Twice daily"></option>
                                    <option value="Three times daily"></option>
                                    <option value="Every 8 hours"></option>
                                    <option value="Every 12 hours"></option>
                                    <option value="As needed"></option>
                                </datalist>
                            </div>
                            <div class="col-md-3">
                                <label for="durationDays" class="form-label fw-bold">Duration (days)</label>
                                <input type="number" id="durationDays" name="durationDays" class="form-control"
                                       min="1" max="365" value="7" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="Medication" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Issue Prescription</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
